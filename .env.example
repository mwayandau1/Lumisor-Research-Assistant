# OpenRouter API (used for both Anthropic LLM and OpenAI embeddings)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Supabase (pgvector)
SUPABASE_URL=https://mkbeufnyuiwrufylqqml.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# Optional model overrides (OpenRouter model format)
PLANNER_MODEL=openai/gpt-4o-mini
PLANNER_TEMPERATURE=0.3

# Used for structured-output nodes (planner JSON, Milestone 3 extraction) -
# needs reliable tool-calling, so it defaults to a stronger model than PLANNER_MODEL.
STRUCTURED_MODEL=openai/gpt-4o-mini
STRUCTURED_TEMPERATURE=0

EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional: log verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
