# OpenRouter API (used for both Anthropic LLM and OpenAI embeddings)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Supabase (pgvector)
SUPABASE_URL=https://mkbeufnyuiwrufylqqml.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# Optional model overrides (OpenRouter model format)
PLANNER_MODEL=openai/gpt-4o-mini
PLANNER_TEMPERATURE=0.3

# Used for structured-output nodes (planner JSON, Milestone 3 extraction) -
# needs reliable tool-calling, so it defaults to a stronger model than PLANNER_MODEL.
STRUCTURED_MODEL=openai/gpt-4o-mini
STRUCTURED_TEMPERATURE=0

EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Milestone 4: sources ---------------------------------------------------

# Which sources the retrieval fan-out runs, in preference order. The first
# source listed supplies the canonical record when two sources return the same
# paper. Set this to just `arxiv` to reproduce Milestone 2 recall for comparison.
ENABLED_SOURCES=arxiv,semantic_scholar

# How many of the planner's expanded queries each source runs, and how many
# results per query. These multiply across sources - turn them down to cut cost.
MAX_SEARCH_QUERIES=5
RESULTS_PER_QUERY=3

# Semantic Scholar works without a key, but unauthenticated traffic shares one
# small global pool and returns HTTP 429 most of the time in practice. A free
# key (https://www.semanticscholar.org/product/api#api-key-form) is strongly
# recommended - without it this source will usually contribute nothing and the
# run will silently fall back to arXiv alone.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_TIMEOUT=20

# Optional: log verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
